API_ID=
API_HASH=

# Твой номер телефона в международном формате, например +420123456789
PHONE=

# Куда слать алерты. Заполнится автоматически при запуске setup.py
LOG_CHAT_ID=

# --- Детект чистки переписки ---
# N удалений от одного человека за WINDOW секунд -> один сводный алерт
PURGE_MIN_COUNT=5
PURGE_WINDOW_SEC=30

# --- Детект блокировки ---
BLOCK_CHECK_ENABLED=true
# Как часто проверять, мин. Каждая проверка — запросы к Telegram по каждому
# активному собеседнику, поэтому чаще двух часов дёргать сеть незачем.
BLOCK_CHECK_INTERVAL_MIN=120
BLOCK_CHECK_ACTIVE_DAYS=7

# --- Кэш медиа ---
# Скользящее окно: файлы неудалённых сообщений старше N дней вычищаются.
# Файл удаляется сразу после отправки алерта в лог-чат.
MEDIA_RETENTION_DAYS=7
MEDIA_MAX_TOTAL_MB=5000
# Файлы крупнее не качаем (алерт придёт, но без вложения)
MEDIA_MAX_FILE_MB=200

# --- Прочее ---
# Отслеживать редактирование сообщений (было -> стало)
TRACK_EDITS=true
# Записи в SQLite старше N дней удаляются. 0 = хранить вечно (иначе бэкфилл сотрётся)
DB_RETENTION_DAYS=0

# --- Поведение ---
# Часовой пояс для дат в алертах. Пусто = локальное время сервера (на VPS обычно UTC).
TIMEZONE=
# Не трекать чаты с ботами
IGNORE_BOTS=true
# Сообщать об удалениях, которых не оказалось в кэше
ALERT_UNKNOWN_DELETES=true
# Сколько файлов максимум прикладывать к сводке о чистке
PURGE_MAX_MEDIA=10
# Сколько проверок подряд признак блокировки должен держаться до алерта
BLOCK_CHECK_STRIKES=2

# --- Мониторинг групп ---
# Следить за групповыми чатами (общие с друзьями), а не только за личками
MONITOR_GROUPS=true
# Порог участников: группы больше этого не трогаем (это уже не «свои»)
GROUP_MAX_MEMBERS=30
# Как часто перепроверять размер чата (вдруг группа разрослась за лимит)
CHAT_RECHECK_HOURS=24
# Алертить, когда удалили ТВОЁ сообщение (собеседник может это сделать в личке).
# Учти: сработает и когда ты удаляешь сам — автора удаления Telegram не сообщает.
ALERT_OWN_DELETES=true
# Потолок собеседников на один цикл проверки блокировок. Страховка от тысяч
# запросов, если активных чатов вдруг станет очень много.
BLOCK_CHECK_MAX_PEERS=20

# --- Heartbeat: сигнал «жив» раз в N дней ---
HEARTBEAT_ENABLED=true
HEARTBEAT_DAYS=7

# --- Дайджест: off | purge (чистки пачкой) | all (всё пачкой) ---
DIGEST_MODE=off
DIGEST_HOURS=24

# --- Архив старого медиа в отдельный склад-канал (по команде /archive) ---
# Пусто = выключено. Создай отдельный приватный канал и впиши его id.
STORAGE_CHAT_ID=
# Пауза между форвардами и потолок за один прогон — берегут аккаунт от флуда
ARCHIVE_DELAY_SEC=3
ARCHIVE_MAX_PER_RUN=200

# --- Поиск /find ---
SEARCH_LIMIT=15

# Пароль для шифрования бэкапов (backup.sh). Храни КОПИЮ отдельно от сервера —
# без него бэкап не восстановить.
BACKUP_PASSPHRASE=

# --- Бот-уведомитель (чтобы алерты приходили НЕПРОЧИТАННЫМИ, с уведомлением) ---
# Получить токен: @BotFather -> /newbot. Пусто = алерты шлёт сам юзербот (без уведомлений).
BOT_TOKEN=
# Куда бот шлёт алерты. Пусто/0 = тебе в личку (нажми Start у своего бота один раз).
BOT_ALERT_CHAT_ID=

# --- View-once ("огонёк") ---
# Сохранять самоуничтожающиеся фото/видео/голосовые сразу при получении.
# ВНИМАНИЕ: это перезаливка чужого контента — на твою ответственность.
CAPTURE_VIEW_ONCE=true
# --- Скрытый просмотр /read ---
READ_DEFAULT=20
READ_MAX=100
# --- Истории (/story) ---
# Сколько историй отдавать за раз, остальные — по кнопке «Показать ещё»
# (иначе 100+ сохранённых уходят одним потоком).
STORY_BATCH=5
# --- Индексация Избранного (удаления в нём не шумят) ---
SAVED_INDEX_LIMIT=20000

# --- Расшифровка голосовых и кружочков ---
# Считается на ТВОЁМ сервере (faster-whisper), аудио никуда не уходит.
# Premium не нужен: его расшифровка работает только по живому сообщению,
# а нам надо разбирать в том числе удалённое — из своего кэша.
TRANSCRIBE_ENABLED=true
# Расшифровывать удалённые голосовые и «огоньки»
TRANSCRIBE_DELETED=true
# tiny / base / small / medium. small — баланс (на 4 ядрах ~1.5x быстрее
# реального времени, русский держит хорошо). base вдвое быстрее и заметно хуже.
# Оставь пустым — установщик подберёт сам по памяти сервера
# (меньше 2 ГБ — base, иначе small). Заполни, если хочешь задать вручную.
WHISPER_MODEL=
# Пусто = определять язык самому. ru — если говорят только по-русски (точнее).
WHISPER_LANG=
# 0 = все ядра минус одно (одно остаётся боту, чтобы не подтормаживал)
WHISPER_THREADS=0
# Потолок длины аудио, сек. Часовой подкаст иначе занял бы ядра на полчаса.
TRANSCRIBE_MAX_SEC=600
TRANSCRIBE_QUEUE_MAX=10

# --- Скачивание по ссылке (TikTok, Instagram, Pinterest, YouTube...) ---
# Кидаешь боту ссылку — присылает файл. Качается на твоём сервере.
DOWNLOADER_ENABLED=true
# TikTok блокирует серверные IP, и куки от этого не спасают. Поэтому прямую
# ссылку (сразу без вотермарки) спрашиваем у открытого API tikwm.com.
# Сервису видно, какие ролики качают. Не устраивает — false, но тогда
# TikTok перестанет работать совсем.
TIKTOK_VIA_API=true
# --- Прокси (нужны для YouTube) ---
# YouTube отдаёт 403 адресу, который он пометил. Порядок попыток бот выбирает
# сам: сначала куки НАПРЯМУЮ (это бесплатно и снимает проверку «подтвердите,
# что вы не робот» даже с помеченного адреса), затем прокси по очереди, и
# только последним — голый прямой заход. Если прямой путь сработал меньше
# часа назад, бот снова начинает с него и прокси не трогает вовсе.
# Прокси уходят только на YouTube-хосты (youtube.com, youtu.be,
# googlevideo.com, music.youtube.com). TikTok, Instagram, Pinterest и прямые
# ссылки качаются с адреса сервера — платный трафик на них не тратится.
# «Жилой» IP не обязателен: подходит любой, которого YouTube ещё не знает.
# Проверено на обычных датацентровых прокси Webshare — через прокси бот идёт
# без куков.
#
# Проще всего положить рядом файл proxies.txt со списком (по одному в строке,
# формат host:port:user:pass — ровно так его отдаёт Webshare). Бот будет
# ходить по кругу и при отказе сам пробовать следующий адрес.
# Здесь — если хочешь один конкретный прокси или свой путь к списку.
DOWNLOAD_PROXY=
PROXY_FILE=
# Разрешать самую последнюю попытку «прокси + куки» — для роликов, закрытых
# до входа (возраст, регион). Для Google это вход с чужого адреса, поэтому
# куки под это должны быть от ОТДЕЛЬНОГО аккаунта, а не от основного.
# false = такой попытки не будет.
COOKIES_WITH_PROXY=true
# Качество по умолчанию (высота кадра). Замерено: 1080p — 30 сек и 80 МБ,
# 720p — 16 сек и 29 МБ. На телефоне разница почти не видна, а ждать вдвое
# меньше. Другое качество доступно кнопкой под готовым файлом.
DOWNLOAD_QUALITY=720
# Спрашивать качество ДО скачивания (кнопки с размерами). Стоит ~9 секунд
# разведки, которые площадка требует в любом случае, зато не качается лишнее.
# false = сразу качать в DOWNLOAD_QUALITY.
ASK_QUALITY=true
# Сколько дней помнить уже скачанное. Повторная ссылка тогда уходит мгновенно:
# Telegram пересылает свой же файл, ничего не качая заново. 0 = не кэшировать.
DOWNLOAD_CACHE_DAYS=90
DOWNLOAD_MAX_MB=300
DOWNLOAD_TIMEOUT_SEC=600
# Куки нужны YouTube и части закрытого контента Instagram. На помеченном
# адресе куки напрямую пробуются ПЕРВЫМИ — это бесплатный обход проверки
# «вы не робот». TikTok куки не нужны (он идёт через API), Pinterest и прямые
# ссылки тоже работают без них. YouTube без куков качается через прокси.
# Трогать эту строку НЕ обязательно: проще прислать файл cookies.txt прямо
# боту — он проверит формат и положит рядом с собой (права 600, в git не идёт).
# Здесь — только если хочешь держать файл в своём месте.
YTDLP_COOKIES=

# --- Слежка за сменой профиля (@username, имя, фото, удаление аккаунта) ---
# Работает только по тем, на кого подписался через /sub
PROFILE_WATCH_ENABLED=true
# Плановый опрос — подстраховка: основное бот ловит мгновенно, по апдейту от
# Telegram. Час — уже слишком редко, чтобы функция ощущалась живой.
PROFILE_CHECK_INTERVAL_MIN=30
# Сколько профилей опрашивать за один прогон. Кого не успели — возьмём в
# следующий заход.
PROFILE_CHECK_MAX_PEERS=30

# --- Онлайн-трекинг (кто когда заходит в сеть) ---
# Выключено по умолчанию: самая шумная функция. Работает только по подписке
# /sub и только если человек не скрыл «был в сети».
ONLINE_WATCH_ENABLED=false
# Не слать «зашёл» чаще этого — клиент мигает статусом при каждом открытии
ONLINE_MIN_GAP_SEC=300

# --- Экспорт переписки в HTML (/export) ---
EXPORT_MAX_MESSAGES=50000
